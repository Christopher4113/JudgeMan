direction: down
vars: { d2-config: { theme-id: 0 } }
classes: {
  blue: { style: { fill: "#0b5394"; font-color: "#ffffff"; stroke: "#0b5394"; border-radius: 4 } }
  light: { style: { fill: "#e8f0f8"; stroke: "#0b5394"; border-radius: 4 } }
  grey: { style: { fill: "#f3f3f3"; stroke: "#555555"; border-radius: 4 } }
}
step: "Every step of a run" { class: light }
rules: "1. Rules\nfree, instant" { class: blue }
small: "2. Small open judge\n\$0.27 per 1,000 steps" { class: blue }
q: "Flagged by either?" { shape: diamond; class: light }
frontier: "3. Frontier judge\n\$17.93 per 1,000 steps" { class: blue }
fine: "Recorded as fine" { class: grey }
verdict: "Verdict and reason" { class: grey }
step -> rules
step -> small
rules -> q
small -> q
q -> frontier: "yes, about 1 in 3"
q -> fine: "no"
frontier -> verdict
